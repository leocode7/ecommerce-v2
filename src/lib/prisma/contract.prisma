// use prisma-8

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String    @unique
  description   String?
  priceCents    Int?
  stock         Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()
}
